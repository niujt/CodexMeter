{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Health",
  "version": "0.1.3",
  "identifier": "com.codexhealth.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Health",
        "width": 1180,
        "height": 800,
        "minWidth": 850,
        "minHeight": 600
      },
      {
        "label": "floating",
        "title": "Codex Health 剩余额度",
        "url": "index.html?window=floating",
        "width": 88,
        "height": 88,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "x": 30,
        "y": 120
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFRjQyQjMyMjgwMzU5QjEKUldTeFdRTW9NaXYwWG4vM25iMmZiMTdYbnJmVms0ODlCamJvb2t0K0hxVmJnS3BwZlVPcGRkNkoK",
      "endpoints": [
        "https://raw.githubusercontent.com/niujt/CodexMeter/main/windows/update/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
